# Exemplo de configuração de variáveis de ambiente
# Copie este arquivo para .env e preencha com os dados reais

# Conexão com o Banco de Dados PostgreSQL
# Exemplo local: postgresql://usuario:senha@localhost:5432/vendas
# Exemplo VPS: postgresql://usuario:senha@ip_da_vps:5432/vendas?sslmode=require
DATABASE_URL=postgresql://postgres:sua_senha_segura@localhost:5432/vendas

# Conexão com o RabbitMQ
# Exemplo local: amqp://guest:guest@localhost:5672/
# Exemplo VPS: amqp://usuario:senha@ip_da_vps:5672/
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Webhook do n8n para envio de alertas ao WhatsApp (usado em produção/desenvolvimento)
N8N_WEBHOOK_URL=https://webhook.2nprogramacao.com.br/webhook/alertas-vendas

